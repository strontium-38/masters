% preamble.sty
% Formatting for IPB thesis using LuaLaTeX + Times New Roman
\ProvidesPackage{preamble}

% ----- Graphics (for logos, figures) -----
\usepackage{graphicx}
\usepackage{tikz}
\usepackage{pgfplots}
\pgfplotsset{compat=1.18}
\setkeys{Gin}{draft=false}

% ----- Font: True Times New Roman (requires LuaLaTeX) -----
\usepackage{fontspec}
\setmainfont{Times New Roman}

% ----- Page Layout (3 cm margins) -----
\usepackage[a4paper,
            top=2.5cm, bottom=2.5cm,
            left=3cm, right=3cm,
            includeheadfoot,
            headheight=14.5pt,
            headsep=0pt,        % body text starts ~3.01 cm from top
            footskip=0.5cm,     % body text ends 3.0 cm from bottom
            ]{geometry}
\setlength{\headheight}{14.5pt}
\setlength{\headsep}{0.8cm}       % ~2.5 cm total header space
\setlength{\footskip}{0.8cm}      % ~2.5 cm total footer space

% ----- Line Spacing -----
\usepackage{setspace}
\onehalfspacing                   % 1.5 line spacing

% ----- Language -----
\usepackage[english]{babel}
\usepackage{datetime}
\usepackage{csquotes}

% ----- Headers & Footers -----
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\nouppercase{\leftmark}}
\fancyhead[R]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\fancypagestyle{plain}{
  \fancyhf{}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

% ----- Bibliography (APA style, uses biber) -----
\usepackage[style=apa, backend=biber]{biblatex}
\addbibresource{references/references.bib}

% reference for includegraphics
\graphicspath{
  {assets/}
  {assets/logos/}
  {assets/figures/}
  {assets/photos/reactor/}
  {assets/photos/ampts/}
}

% ----- Standalone figures -----
\usepackage{standalone}
\standaloneconfig{mode=tex}

% ----- Math & Tables -----
\usepackage{amsmath, amssymb}
\usepackage{booktabs}
\usepackage[labelfont=bf]{caption}
\usepackage{subcaption}
\usepackage{siunitx}
\usepackage{chemmacros}
\usepackage[version=4]{mhchem}

\chemsetup{formula=mhchem}

\sisetup{
  per-mode=power,
  inter-unit-product  = \ , % mg L⁻¹
  %inter-unit-product = \ensuremath{{}\cdot{}}, % mg·L⁻¹
}
\newcommand{\tablesetup}{%
  \sisetup{%
    exponent-mode          = scientific,
    round-mode             = places,
    round-precision        = 3,
    output-exponent-marker = \text{e},
  }%
}

\usepackage{pdflscape}
\usepackage{rotating}
\usepackage{makecell}
\usepackage{multirow}
\usepackage{threeparttable}
\usepackage{xltabular}
\usepackage{threeparttablex}
\usepackage{makecell}

\usepackage{pgfplotstable}
\usepackage{csvsimple}

% ----- Microtype for better character protrusion (LuaLaTeX compatible) -----
\usepackage{microtype}

% ----- Hyperlinks (load last) -----
\usepackage{hyperref}
\hypersetup{
    colorlinks = true,
    linkcolor  = black,
    citecolor  = black,
    urlcolor   = blue,
}
\usepackage{xstring}

% references
\usepackage{cleveref}

\crefname{figure}{Fig.}{Figs.}
\Crefname{figure}{Fig.}{Figs.}

\crefname{table}{Table}{Tables}
\Crefname{table}{Table}{Tables}

% positioning
\usepackage{float}

% Tables
\newcolumntype{C}{>{\centering\arraybackslash}X}

% special declarations
\DeclareSIUnit\nml{NmL}
\DeclareSIUnit\normality{N}
\DeclareSIUnit\dil{X}
\DeclareSIUnit\molar{M}
\DeclareSIUnit\gforce{G}
\DeclareSIUnit\tonne{tonnes}
\DeclareSIUnit\yr{yr}

\DeclareSIUnit\VS{VS}

\DeclareSIUnit\CHCOOH{\ce{CH3COOH}}
\DeclareSIUnit\CaCO{\ce{CaCO3}}
\DeclareSIUnit\NaOH{\ce{NaOH}}
\DeclareSIUnit\CO{\ce{CO2}}

% ----- Glossaries (abbreviations, symbols, units) -----
\usepackage[
  record,            % use bib2gls
  abbreviations,     % defines 'abbreviations' glossary type
  symbols,           % defines 'symbols' glossary type
  nomain,            % we don't need a main glossary
  nonumberlist,      % no page numbers
  nopostdot,         % no trailing dot
  nogroupskip,       % no extra skip between groups
  style=super,        % abbreviations style
  nohypertypes={symbols,units},
]{glossaries-extra}

\newglossary*{units}{Units}

\GlsXtrLoadResources[
  src = {glossaries/abbreviations},
  type = abbreviations,
  selection = {recorded and deps},   % only used (recorded) entries
]
\GlsXtrLoadResources[
  src = {glossaries/symbols},
  type = symbols,
  selection = {recorded and deps},
]
\GlsXtrLoadResources[
  src = {glossaries/units},
  type = units,
  selection = {all},
  sort      = {def},
]
